#!/bin/sh
set -eu

ruff check .

# Run pytest; skip gracefully if dependencies (e.g. neo4j) are unavailable locally
pytest || {
    EXIT=$?
    if pytest --collect-only 2>&1 | grep -q "ModuleNotFoundError"; then
        echo "[pre-commit] Skipping tests: missing optional runtime dependency (e.g. neo4j). Run full suite in CI."
        exit 0
    fi
    exit $EXIT
}
